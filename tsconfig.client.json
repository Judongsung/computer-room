{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "test/client/**/*.ts",
    "test/client/**/*.tsx"
  ]
}

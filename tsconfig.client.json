{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@client/*": ["./src/client/*"],
      "@test/*": ["./test/*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/constants/api.ts",
    "src/constants/media.ts",
    "src/constants/widget.ts",
    "src/domain/media-type.ts",
    "src/domain/widget-layout.ts",
    "src/domain/widget-contract.ts",
    "src/types/auth.ts",
    "src/types/file.ts",
    "src/types/filesystem.ts",
    "src/types/media.ts",
    "src/types/widget.ts",
    "test/client/**/*.ts",
    "test/client/**/*.tsx"
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "computer-room",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/login"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "computer-room-db",
      "database_id": "a48b9cc7-fd14-4df8-b74d-9136434998c5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "computer-room-files"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "GUEST_METADATA_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "GUEST_BINARY_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 15 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src/types/platform/generated/worker-configuration.d.ts",
    "src/**/*.ts",
    "db/**/*.ts",
    "test/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "src/client",
    "test/client",
    "vite.config.ts",
    "vitest.client.config.ts",
    "vitest.unit.config.ts"
  ]
}

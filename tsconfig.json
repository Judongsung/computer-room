{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@client/*": ["./src/client/*"],
      "@test/*": ["./test/*"]
    },
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "db/**/*.ts",
    "test/**/*.ts",
    "*.ts"
  ],
  "exclude": ["src/client", "test/client", "vite.config.ts", "vitest.client.config.ts"]
}
